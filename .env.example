# PostgreSQL / PostGIS Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=roadsafe_ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadsafe_ai?schema=public

# Node.js API Service Configuration
PORT=3000
JWT_SECRET=change_me_in_production
ADMIN_JWT_SECRET=change_me_admin_secret_in_production
NODE_ENV=development

# Geocoder, Broad Routing & Regional Hazard Feed Configuration
GEOCODE_USER_AGENT=RoadSafe-AI-PublicDriverApp/2.0
OSRM_BASE_URL=https://router.project-osrm.org
HAZARD_FEED_REFRESH_MIN=15
NDMA_RAJASTHAN_RSS=https://sachet.ndma.gov.in/cap_public_website/rss/rss_rajasthan.xml
NDMA_UTTARAKHAND_RSS=https://sachet.ndma.gov.in/cap_public_website/rss/rss_uttarakhand.xml
NDMA_HIMACHAL_RSS=https://sachet.ndma.gov.in/cap_public_website/rss/rss_himachal.xml
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&minlatitude=23&maxlatitude=34&minlongitude=69&maxlongitude=82&minmagnitude=3.5&limit=10
OFFICIAL_ALERTS_FEED_URL=

# Python Routing Microservice (Internal)
PYTHON_ROUTING_URL=http://localhost:8000

